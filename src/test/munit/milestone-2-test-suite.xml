<munit:test name="actual-standard-listener-enriches-and-approves">
<munit:enable-flow-sources><munit:enable-flow-source value="scoring-consumer-standard-flow"/></munit:enable-flow-sources>
<munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution>
<vm:publish config-ref="VM_Config" queueName="${vm.queue.standard}"><vm:content>#[output application/java --- {event:(vars.evt update {case e at .eventId -> 'ASYNC-STD'}),correlationId:'standard-consumer-corr',velocityCount:1,riskConfig:vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]</vm:content></vm:publish>
<vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="3"/>
