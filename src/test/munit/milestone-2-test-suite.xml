<vm:config name="M2_Test_VM"><vm:queues><vm:queue queueName="m2-rollback-in" queueType="PERSISTENT" maxOutstandingMessages="100"/></vm:queues></vm:config>
<munit:test name="velocity-card-isolation-idempotent-retry-and-sliding-expiry"><munit:execution><set-variable variableName="event" value="#[output application/java --- vars.evt]"/><set-variable variableName="eventId" value="#[output application/java --- 'V1']"/><set-variable variableName="velocityNowEpoch" value="#[output application/java --- 100]"/><flow-ref name="velocity-update-sf"/><set-variable variableName="first" value="#[output application/java --- vars.velocityCount]"/><set-variable variableName="eventId" value="#[output application/java --- 'V2']"/><flow-ref name="velocity-update-sf"/><set-variable variableName="second" value="#[output application/java --- vars.velocityCount]"/><flow-ref name="velocity-update-sf"/><set-variable variableName="retryCount" value="#[output application/java --- vars.velocityCount]"/><set-variable variableName="event" value="#[output application/java --- vars.evt update {case c at .card.cardToken -> 'TKN-OTHER'}]"/><set-variable variableName="eventId" value="#[output application/java --- 'V3']"/><flow-ref name="velocity-update-sf"/><set-variable variableName="other" value="#[output application/java --- vars.velocityCount]"/><set-variable variableName="event" value="#[output application/java --- vars.evt]"/><set-variable variableName="eventId" value="#[output application/java --- 'V4']"/><set-variable variableName="velocityNowEpoch" value="#[output application/java --- 103]"/><flow-ref name="velocity-update-sf"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.first]" is="#[MunitTools::equalTo(1)]"/><munit-tools:assert-that expression="#[vars.second]" is="#[MunitTools::equalTo(2)]"/><munit-tools:assert-that expression="#[vars.retryCount]" is="#[MunitTools::equalTo(2)]"/><munit-tools:assert-that expression="#[vars.other]" is="#[MunitTools::equalTo(1)]"/><munit-tools:assert-that expression="#[vars.velocityCount]" is="#[MunitTools::equalTo(1)]"/></munit:validation></munit:test>
<munit:test name="velocity-object-store-entry-really-expires"><munit:execution><set-variable variableName="event" value="#[output application/java --- vars.evt]"/><set-variable variableName="eventId" value="#[output application/java --- 'TTL1']"/><flow-ref name="velocity-update-sf"/><until-successful maxRetries="10" millisBetweenRetries="500"><os:contains objectStore="velocityStore" key="vel-TKN-1" target="stillAlive"/><choice><when expression="#[vars.stillAlive]"><raise-error type="APP:WAIT_FOR_TTL" description="Waiting for test TTL sweep"/></when></choice></until-successful></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.stillAlive]" is="#[MunitTools::equalTo(false)]"/></munit:validation></munit:test>
<munit:test name="all-band-boundaries-and-score-cap"><munit:execution><set-variable variableName="bands" value="#[output application/java --- [29,30,31,59,60,61,100] map modules::RiskRules::band($, vars.cfg)]"/><set-variable variableName="score" value="#[output application/java --- modules::RiskRules::evaluate(vars.evt update {case a at .transaction.amount -> 200000 case m at .merchant.merchantCountry -> 'SG' case c at .merchant.merchantCategory -> 'CRYPTO' case t at .eventTimestamp -> '2026-09-11T03:00:00+05:30'}, {velocityCount:6,profile:{riskProfile:'WATCHLIST'}}, vars.cfg).score]"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.bands == ['LOW','MEDIUM','MEDIUM','MEDIUM','HIGH','HIGH','HIGH']]" is="#[MunitTools::equalTo(true)]"/><munit-tools:assert-that expression="#[vars.score]" is="#[MunitTools::equalTo(100)]"/></munit:validation></munit:test>
<munit:test name="overnight-hours-and-watchlist-positive-negative"><munit:execution><set-variable variableName="inside" value="#[output application/java --- modules::RiskRules::ruleHour(vars.evt update {case t at .eventTimestamp -> '2026-09-11T23:00:00+05:30'}, {profile:{usualHourStart:22,usualHourEnd:6}}, vars.cfg)]"/><set-variable variableName="outside" value="#[output application/java --- modules::RiskRules::ruleHour(vars.evt, {profile:{usualHourStart:22,usualHourEnd:6}}, vars.cfg)]"/><set-variable variableName="watch" value="#[output application/java --- modules::RiskRules::ruleWatchlist({profile:{riskProfile:'WATCHLIST'}}, vars.cfg)]"/><set-variable variableName="standard" value="#[output application/java --- modules::RiskRules::ruleWatchlist({profile:{riskProfile:'STANDARD'}}, vars.cfg)]"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.inside == null]" is="#[MunitTools::equalTo(true)]"/><munit-tools:assert-that expression="#[vars.outside.ruleCode]" is="#[MunitTools::equalTo('R05_ODD_HOUR')]"/><munit-tools:assert-that expression="#[vars.watch.ruleCode]" is="#[MunitTools::equalTo('R06_WATCHLIST')]"/><munit-tools:assert-that expression="#[vars.standard == null]" is="#[MunitTools::equalTo(true)]"/></munit:validation></munit:test>
<munit:test name="consumer-approves-low-with-profile"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('APPROVE')]"/><munit-tools:assert-that expression="#[payload.final.riskScore]" is="#[MunitTools::equalTo(0)]"/><munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('consumer-test-corr')]"/><munit-tools:assert-that expression="#[payload.event.eventId == vars.envelope.event.eventId]" is="#[MunitTools::equalTo(true)]"/></munit:validation></munit:test>
<munit:test name="consumer-reviews-medium"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt update {case a at .transaction.amount -> 100001}), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('REVIEW')]"/><munit-tools:assert-that expression="#[payload.final.riskScore]" is="#[MunitTools::equalTo(35)]"/><munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('consumer-test-corr')]"/><munit-tools:assert-that expression="#[payload.event.eventId == vars.envelope.event.eventId]" is="#[MunitTools::equalTo(true)]"/></munit:validation></munit:test>
<munit:test name="consumer-blocks-watchlist-sample"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'WATCHLIST',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (readUrl('classpath://payment-event.json','application/json')), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('BLOCK')]"/><munit-tools:assert-that expression="#[payload.final.riskScore]" is="#[MunitTools::equalTo(92)]"/><munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('consumer-test-corr')]"/><munit-tools:assert-that expression="#[payload.event.eventId == vars.envelope.event.eventId]" is="#[MunitTools::equalTo(true)]"/></munit:validation></munit:test>
<munit:test name="consumer-scoring-error-forces-review"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt update {case t at .eventTimestamp -> 'bad-date'}), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('REVIEW')]"/><munit-tools:assert-that expression="#[payload.final.riskScore]" is="#[MunitTools::equalTo(45)]"/><munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('consumer-test-corr')]"/><munit-tools:assert-that expression="#[payload.event.eventId == vars.envelope.event.eventId]" is="#[MunitTools::equalTo(true)]"/></munit:validation></munit:test>
<munit:test name="missing-profile-is-recorded-and-never-approved"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('REVIEW')]"/><munit-tools:assert-that expression="#[payload.enrichmentIncomplete]" is="#[MunitTools::equalTo(true)]"/><munit-tools:assert-that expression="#[payload.profile.riskProfile]" is="#[MunitTools::equalTo('STANDARD')]"/></munit:validation></munit:test>
<munit:test name="intake-scoring-failure-preserved-through-consumer"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:45,riskBand:'MEDIUM',ruleHits:[{ruleCode:'SYS_SCORING_FAILURE',ruleName:'Manual review',ruleWeight:0}],scoringFailed:true}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('REVIEW')]"/><munit-tools:assert-that expression="#[sizeOf(payload.final.ruleHits filter ($.ruleCode == 'SYS_SCORING_FAILURE'))]" is="#[MunitTools::equalTo(1)]"/></munit:validation></munit:test>
<munit:test name="high-event-on-standard-is-rerouted-before-db"><munit:behavior><munit-tools:mock-when processor="vm:publish"><munit-tools:then-return><munit-tools:payload value="#[payload]"/></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><set-payload value="#[output application/java --- {event: (vars.evt), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:82,riskBand:'HIGH',ruleHits:[],scoringFailed:false}}]"/><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try transactionalAction="ALWAYS_BEGIN"><flow-ref name="process-scored-event-sf"/></try></munit:execution><munit:validation><munit-tools:verify-call processor="vm:publish" times="1"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="queueName" whereValue="#[p('vm.queue.high')]"/></munit-tools:with-attributes></munit-tools:verify-call><munit-tools:verify-call processor="db:select" times="0"/></munit:validation></munit:test>
<munit:test name="db-outage-rolls-back-real-vm-consume"><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:error typeId="DB:CONNECTIVITY"/></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><vm:publish config-ref="M2_Test_VM" queueName="m2-rollback-in"><vm:content>#[output application/java --- {event: (vars.evt), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:0,riskBand:'LOW',ruleHits:[],scoringFailed:false}}]</vm:content></vm:publish><set-variable variableName="sourceQueue" value="#[output application/java --- p('vm.queue.standard')]"/><try><try transactionalAction="ALWAYS_BEGIN"><vm:consume config-ref="M2_Test_VM" queueName="m2-rollback-in" timeout="2"/><flow-ref name="process-scored-event-sf"/><error-handler ref="scoringConsumerErrorHandler"/></try><error-handler><on-error-continue logException="false" enableNotifications="false"><set-variable variableName="rolledBack" value="#[true]"/></on-error-continue></error-handler></try><vm:consume config-ref="M2_Test_VM" queueName="m2-rollback-in" timeout="2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.rolledBack]" is="#[MunitTools::equalTo(true)]"/><munit-tools:assert-that expression="#[payload.event.eventId]" is="#[MunitTools::equalTo('T-1')]"/><munit-tools:verify-call processor="db:select" times="4"/></munit:validation></munit:test>
<munit:test name="rule-file-edit-takes-effect-without-redeploy"><munit:enable-flow-sources><munit:enable-flow-source value="payment-events-api-main"/></munit:enable-flow-sources><munit:execution><set-variable variableName="policyEventId" value="#[output application/java --- 'POLICY1']"/><http:request config-ref="Intake_Test_Client" method="POST" path="/api/payments/events" target="policyResponse" targetValue="#[message]"><http:body>#[output application/json --- vars.evt update {case e at .eventId -> vars.policyEventId}]</http:body><http:headers>#[{'Content-Type':'application/json'}]</http:headers><http:response-validator><http:success-status-code-validator values="200..599"/></http:response-validator></http:request><set-variable variableName="before" value="#[output application/java --- vars.policyResponse.payload.riskScore]"/><file:write config-ref="Risk_Policy_File_Config" path="${risk.policyFile}"><file:content>#[output application/json --- vars.cfg update {case a at .amountLimit -> 1000}]</file:content></file:write><set-variable variableName="policyEventId" value="#[output application/java --- 'POLICY2']"/><http:request config-ref="Intake_Test_Client" method="POST" path="/api/payments/events" target="policyResponse" targetValue="#[message]"><http:body>#[output application/json --- vars.evt update {case e at .eventId -> vars.policyEventId}]</http:body><http:headers>#[{'Content-Type':'application/json'}]</http:headers><http:response-validator><http:success-status-code-validator values="200..599"/></http:response-validator></http:request><vm:consume config-ref="VM_Config" queueName="${vm.queue.standard}" timeout="2" target="policyCleanup1"/><vm:consume config-ref="VM_Config" queueName="${vm.queue.standard}" timeout="2" target="policyCleanup2"/></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.before]" is="#[MunitTools::equalTo(0)]"/><munit-tools:assert-that expression="#[vars.policyResponse.attributes.statusCode]" is="#[MunitTools::equalTo(202)]"/><munit-tools:assert-that expression="#[vars.policyResponse.payload.riskScore]" is="#[MunitTools::equalTo(35)]"/></munit:validation></munit:test>
<munit:test name="invalid-live-policy-503-no-publication"><munit:enable-flow-sources><munit:enable-flow-source value="payment-events-api-main"/></munit:enable-flow-sources><munit:execution><file:write config-ref="Risk_Policy_File_Config" path="${risk.policyFile}"><file:content>#[output application/json --- vars.cfg update {case h at .highMin -> 10}]</file:content></file:write><set-variable variableName="policyEventId" value="#[output application/java --- 'INVALIDCFG']"/><http:request config-ref="Intake_Test_Client" method="POST" path="/api/payments/events" target="policyResponse" targetValue="#[message]"><http:body>#[output application/json --- vars.evt update {case e at .eventId -> vars.policyEventId}]</http:body><http:headers>#[{'Content-Type':'application/json'}]</http:headers><http:response-validator><http:success-status-code-validator values="200..599"/></http:response-validator></http:request></munit:execution><munit:validation><munit-tools:assert-that expression="#[vars.policyResponse.attributes.statusCode]" is="#[MunitTools::equalTo(503)]"/><munit-tools:verify-call processor="vm:publish" times="0"/></munit:validation></munit:test>
<munit:test name="actual-high-listener-enriches-and-hands-off"><munit:enable-flow-sources><munit:enable-flow-source value="scoring-consumer-high-flow"/></munit:enable-flow-sources><munit:behavior><munit-tools:mock-when processor="db:select"><munit-tools:then-return><munit-tools:variables><munit-tools:variable key="profileRows" value="#[[{customer_id:'C-1',risk_profile:'STANDARD',usual_hour_start:6,usual_hour_end:23}]]"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when></munit:behavior><munit:execution><vm:publish config-ref="VM_Config" queueName="${vm.queue.high}"><vm:content>#[output application/java --- {event: (readUrl('classpath://payment-event.json','application/json') update {case e at .eventId -> 'ASYNC-M2'}), correlationId:'consumer-test-corr',velocityCount:1,riskConfig: vars.cfg,scoring:{riskScore:82,riskBand:'HIGH',ruleHits:[],scoringFailed:false}}]</vm:content></vm:publish><until-successful maxRetries="10" millisBetweenRetries="250"><vm:consume config-ref="VM_Config" queueName="${vm.queue.decisions}" timeout="1"/><choice><when expression="#[payload.event.eventId != 'ASYNC-M2']"><raise-error type="APP:OTHER_TEST_EVENT" description="Skipping unrelated test event"/></when></choice></until-successful></munit:execution><munit:validation><munit-tools:assert-that expression="#[payload.final.riskScore]" is="#[MunitTools::equalTo(82)]"/><munit-tools:assert-that expression="#[payload.final.decision]" is="#[MunitTools::equalTo('REVIEW')]"/><munit-tools:assert-that expression="#[payload.correlationId]" is="#[MunitTools::equalTo('consumer-test-corr')]"/></munit:validation></munit:test>

